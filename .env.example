# Valori privati e segreti reali vengono generati solo localmente da scripts/setup.py.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_RESEARCH_MODEL=qwen3.5:4b
OLLAMA_WRITING_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192
SEARXNG_BASE_URL=http://searxng:8080
CRAWL4AI_BASE_URL=http://crawl4ai:11235
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=AIJobHunter/0.1 (private self-hosted research)
MAX_UPLOAD_MB=10
MAX_COMPANIES=50
MAX_RADIUS_KM=300
MAX_SEARCH_QUERIES=25
MAX_PAGES_PER_COMPANY=6
MAX_TOTAL_RUNTIME=1800
RETENTION_DAYS=30
CACHE_HOURS=24
RETAIN_ORIGINAL_PDF=false
EMAIL_DRAFT_ENABLED=false
EMAIL_DRAFT_MIN_FIT=60
STIRLING_ENABLED=false
STIRLING_BASE_URL=
STIRLING_OCR_LANGUAGES=ita,eng
NEXTCLOUD_ENABLED=false
# URL della SOLA cartella consentita, per esempio .../remote.php/dav/files/utente/JobHunter
NEXTCLOUD_WEBDAV_URL=
# Integrazioni opzionali: montare secret file nel container e impostarne i percorsi.
# STIRLING_API_KEY_FILE=/run/secrets/stirling_api_key
# NEXTCLOUD_USER_FILE=/run/secrets/nextcloud_user
# NEXTCLOUD_APP_PASSWORD_FILE=/run/secrets/nextcloud_password
N8N_BIND_ADDRESS=127.0.0.1
N8N_SECURE_COOKIE=true
