{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "person_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Person Name"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Role"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "category": {
          "enum": [
            "recruiting",
            "general",
            "professional"
          ],
          "title": "Category",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "quote": {
          "maxLength": 600,
          "minLength": 3,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "person_name",
        "role",
        "email",
        "category",
        "source_url",
        "quote"
      ],
      "title": "Contact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Contact"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "Contacts",
  "type": "object"
}
